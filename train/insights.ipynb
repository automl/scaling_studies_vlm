   "source": "Failure predictor data",
   "id": "757048282254f413"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "import pandas as pd\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "FEATURE_COLS = [\n",
    "    \"config_id\",\n",
    "    \"global_batch_size\",\n",
    "    \"beta1\",\n",
    "    \"beta2\",\n",
    "    \"eps\",\n",
    "    \"lr\",\n",
    "    \"text_width\",\n",
    "    \"vision_width\",\n",
    "    \"warmup_fraction\",\n",
    "    \"wd\",\n",
    "    \"total_samples_planned\",\n",
    "]\n",
    "\n",
    "\n",
    "def build_failure_labels(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    fail_df = (\n",
    "        df.groupby(\"config_id\", as_index=False)[\"epoch_diverged\"]\n",
    "        .any()\n",
    "        .rename(columns={\"epoch_diverged\": \"failed\"})\n",
    "    )\n",
    "    fail_df[\"failed\"] = fail_df[\"failed\"].astype(int)\n",
    "    return fail_df\n",
    "\n",
    "\n",
    "def build_feature_table(df: pd.DataFrame, feature_cols: list[str]) -> pd.DataFrame:\n",
    "    missing_cols = [col for col in feature_cols if col not in df.columns]\n",
    "    if missing_cols:\n",
    "        raise ValueError(f\"Missing required feature columns: {missing_cols}\")\n",
    "\n",
    "    features_df = (\n",
    "        df[feature_cols]\n",
    "        .sort_values(\"config_id\")\n",
    "        .drop_duplicates(subset=\"config_id\", keep=\"first\")\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "    return features_df\n",
    "\n",
    "\n",
    "def build_full_failure_dataset(df: pd.DataFrame, feature_cols: list[str]) -> pd.DataFrame:\n",
    "    fail_df = build_failure_labels(df)\n",
    "    features_df = build_feature_table(df, feature_cols)\n",
    "\n",
    "    result = features_df.merge(fail_df, on=\"config_id\", how=\"inner\")\n",
    "    result = result.sort_values(\"config_id\").reset_index(drop=True)\n",
    "    return result\n",
    "\n",
    "\n",
    "def split_failed_configs(\n",
    "        full_failure_df: pd.DataFrame,\n",
    "        test_size: float = 0.2,\n",
    "        random_state: int = 42,\n",
    ") -> tuple[pd.DataFrame, pd.DataFrame]:\n",
    "    failed_df = full_failure_df[full_failure_df[\"failed\"] == 1].copy()\n",
    "\n",
    "    train_failed_df, test_failed_df = train_test_split(\n",
    "        failed_df,\n",
    "        test_size=test_size,\n",
    "        random_state=random_state,\n",
    "    )\n",
    "\n",
    "    train_failed_df = train_failed_df.sort_values(\"config_id\").reset_index(drop=True)\n",
    "    test_failed_df = test_failed_df.sort_values(\"config_id\").reset_index(drop=True)\n",
    "\n",
    "    return train_failed_df, test_failed_df\n",
    "\n",
    "\n",
    "def load_nonfailed_split(csv_path: str, feature_cols: list[str]) -> pd.DataFrame:\n",
    "    df = pd.read_csv(csv_path)\n",
    "\n",
    "    missing_cols = [col for col in feature_cols if col not in df.columns]\n",
    "    if missing_cols:\n",
    "        raise ValueError(f\"Missing required columns in {csv_path}: {missing_cols}\")\n",
    "\n",
    "    result = (\n",
    "        df[feature_cols]\n",
    "        .sort_values(\"config_id\")\n",
    "        .drop_duplicates(subset=\"config_id\", keep=\"first\")\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "    result[\"failed\"] = 0\n",
    "    return result\n",
    "\n",
    "\n",
    "def combine_failure_split(\n",
    "        nonfailed_df: pd.DataFrame,\n",
    "        failed_df: pd.DataFrame,\n",
    ") -> pd.DataFrame:\n",
    "    result = pd.concat([nonfailed_df, failed_df], ignore_index=True)\n",
    "    result = result.sort_values(\"config_id\").reset_index(drop=True)\n",
    "    return result\n",
    "\n",
    "\n",
    "def main() -> None:\n",
    "    full_csv = \"../surrogate_benchmark/data.csv\"\n",
    "    perplexity_train_csv = \"../surrogate_benchmark/performance_surrogate/splits/train.csv\"\n",
    "    perplexity_test_csv = \"../surrogate_benchmark/performance_surrogate/splits/test.csv\"\n",
    "\n",
    "    output_train_csv = \"../surrogate_benchmark/divergence_surrogate/splits/train.csv\"\n",
    "    output_test_csv = \"../surrogate_benchmark/divergence_surrogate/splits/test.csv\"\n",
    "\n",
    "    full_df = pd.read_csv(full_csv)\n",
    "\n",
    "    full_failure_df = build_full_failure_dataset(full_df, FEATURE_COLS)\n",
    "\n",
    "    train_failed_df, test_failed_df = split_failed_configs(\n",
    "        full_failure_df,\n",
    "        test_size=0.2,\n",
    "        random_state=42,\n",
    "    )\n",
    "\n",
    "    train_nonfailed_df = load_nonfailed_split(perplexity_train_csv, FEATURE_COLS)\n",
    "    test_nonfailed_df = load_nonfailed_split(perplexity_test_csv, FEATURE_COLS)\n",
    "\n",
    "    failure_train_df = combine_failure_split(train_nonfailed_df, train_failed_df)\n",
    "    failure_test_df = combine_failure_split(test_nonfailed_df, test_failed_df)\n",
    "\n",
    "    print(\"Failure train shape:\", failure_train_df.shape)\n",
    "    print(\"Failure test shape:\", failure_test_df.shape)\n",
    "\n",
    "    print(\"\\nTrain class counts:\")\n",
    "    print(failure_train_df[\"failed\"].value_counts().sort_index())\n",
    "\n",
    "    print(\"\\nTest class counts:\")\n",
    "    print(failure_test_df[\"failed\"].value_counts().sort_index())\n",
    "\n",
    "    failure_train_df.to_csv(output_train_csv, index=False)\n",
    "    failure_test_df.to_csv(output_test_csv, index=False)\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ],
   "id": "cfb7564d1e1f7151",
   "outputs": [],
   "execution_count": null
  },
