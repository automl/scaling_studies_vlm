    "# Different possibilities\n",
    "# 1. Inverse transform sampling(To map uniform random values to any target distribution, you use the inverse CDF of that distribution) of values from uniform distribution to exponential(lambda) distribution. We need to truncate and shift the distribution.\n",
    "# 2. sample directly from a log distribution. Same logic by finding the inverse CDF.\n",
    "\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "lower = 0.6\n",
    "upper = 60.0\n",
    "\n",
    "x = np.linspace(lower, upper, 2000)\n",
    "\n",
    "pdf_linear = np.ones_like(x) / (upper - lower)\n",
    "pdf_log = 1.0 / (x * np.log(upper / lower))\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(x, pdf_linear, label=\"Linear sampling\", linewidth=2)\n",
    "plt.plot(x, pdf_log, label=\"Log sampling (∝ 1/x)\", linewidth=2)\n",
    "\n",
    "plt.xlabel(\"train_num_samples (millions)\")\n",
    "plt.ylabel(\"Probability density\")\n",
    "plt.title(\"Probability density: linear vs log sampling\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "\n",
    "plt.show()\n"
   ],
