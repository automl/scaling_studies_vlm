   "source": [
    "def compute_global_rate(df):\n",
    "    df = df.sort_values([\"config_id\", \"epoch\"])\n",
    "\n",
    "    deltas = []\n",
    "    durations = []\n",
    "\n",
    "    for _, g in df.groupby(\"config_id\"):\n",
    "        g = g.sort_values(\"epoch\")\n",
    "\n",
    "        for i in range(1, len(g)):\n",
    "            d_prog = g.iloc[i][\"samples_seen_frac\"] - g.iloc[i - 1][\"samples_seen_frac\"]\n",
    "            d_time = g.iloc[i][\"train_duration(s)\"]\n",
    "\n",
    "            if pd.notna(d_time) and d_prog > 0:\n",
    "                deltas.append(d_prog)\n",
    "                durations.append(d_time)\n",
    "\n",
    "    return sum(durations) / sum(deltas)\n",
    "\n",
    "\n",
    "def fill_single_epoch(df):\n",
    "    rate = compute_global_rate(df)\n",
    "\n",
    "    for idx, row in df.iterrows():\n",
    "        if pd.isna(row[\"train_duration(s)\"]):\n",
    "            df.loc[idx, \"train_duration(s)\"] = row[\"samples_seen_frac\"] * rate\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "df = pd.read_csv(\"../surrogate_benchmark/vlm/data.csv\")\n",
    "updated_df = fill_single_epoch(df)\n",
    "updated_df.to_csv(\"../surrogate_benchmark/data.csv\", index=False)"
   ],
