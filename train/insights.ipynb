    "\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def pick_log_spaced_pareto_points(\n",
    "        csv_path_or_df,\n",
    "        *,\n",
    "        compute_col: str = \"Total compute(GLOPs)\",\n",
    "        id_col: str = \"config_id\",\n",
    "        k: int = 8,\n",
    "        drop_last_nan_id: bool = True,\n",
    ") -> pd.DataFrame:\n",
    "    if isinstance(csv_path_or_df, pd.DataFrame):\n",
    "        df = csv_path_or_df.copy()\n",
    "    else:\n",
    "        df = pd.read_csv(csv_path_or_df)\n",
    "\n",
    "    df[compute_col] = pd.to_numeric(df[compute_col], errors=\"coerce\")\n",
    "    if id_col in df.columns:\n",
    "        df[id_col] = pd.to_numeric(df[id_col], errors=\"coerce\")\n",
    "\n",
    "    df = df.dropna(subset=[compute_col])\n",
    "    df = df[df[compute_col] > 0]\n",
    "\n",
    "    if drop_last_nan_id and id_col in df.columns:\n",
    "        df = df.dropna(subset=[id_col])\n",
    "\n",
    "    if len(df) < k:\n",
    "        raise ValueError(f\"Not enough rows ({len(df)}) to pick k={k} points.\")\n",
    "\n",
    "    df = df.sort_values(compute_col).reset_index(drop=True)\n",
    "\n",
    "    df[\"compute_log10\"] = np.log10(df[compute_col].to_numpy(dtype=float))\n",
    "\n",
    "    lo = float(df[\"compute_log10\"].min())\n",
    "    hi = float(df[\"compute_log10\"].max())\n",
    "    targets = np.linspace(lo, hi, k)\n",
    "\n",
    "    selected_idx = []\n",
    "    remaining = set(range(len(df)))\n",
    "\n",
    "    for t in targets:\n",
    "        cand = np.array(sorted(remaining), dtype=int)\n",
    "        dist = np.abs(df.loc[cand, \"compute_log10\"].to_numpy() - t)\n",
    "        best_local = int(cand[int(np.argmin(dist))])\n",
    "        selected_idx.append(best_local)\n",
    "        remaining.remove(best_local)\n",
    "\n",
    "    out = df.loc[selected_idx].copy()\n",
    "    out[\"target_log10\"] = targets\n",
    "    out[\"log10_distance\"] = np.abs(out[\"compute_log10\"].to_numpy() - targets)\n",
    "\n",
    "    out = out.sort_values(\"target_log10\").reset_index(drop=True)\n",
    "    return out\n",
    "\n",
    "\n",
    "pick_log_spaced_pareto_points(csv_path_or_df=\"results/juwels_joint_results/val_loss/pareto_front.csv\")"
   ],
