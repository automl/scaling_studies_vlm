    "slope = -0.2111\n",
    "intercept = 3.9256\n",
    "out_worst = \"worst10_relative_to_scaling_law.csv\"\n",
    "out_best = \"best10_relative_to_scaling_law.csv\"\n",
    "\n",
    "df = pd.read_csv(in_csv)\n",
    "df = df[df[\"val_loss\"].notna() & df[\"Total compute(GLOPs)\"].notna()].copy()\n",
    "\n",
    "log_flops = np.log(df[\"Total compute(GLOPs)\"])\n",
    "log_loss = np.log(df[\"val_loss\"])\n",
    "predicted_log_loss = slope * log_flops + intercept\n",
    "df[\"distance_to_frontier\"] = log_loss - predicted_log_loss\n",
    "\n",
    "df[\"total_samples\"] = df[\"train_num_samples\"] * df[\"epochs\"]\n",
    "\n",
    "df_under = df[df[\"distance_to_frontier\"] > 0].copy()\n",
    "worst20 = df_under.sort_values(\"distance_to_frontier\", ascending=False).head(20)\n",
    "\n",
    "best20 = df.sort_values(\"distance_to_frontier\", ascending=True).head(20)\n",
    "\n",
    "worst20.to_csv(out_worst, index=False)\n",
    "best20.to_csv(out_best, index=False)\n",
    "\n",
