    "from train.utils import build_model_cfg\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "WIDTHS = [32, 64, 128, 192, 256, 320, 384, 448, 512]\n",
    "CONFIG_ROOT = Path(\"generated_model_configs\")\n",
    "\n",
    "TRAIN_BASE_CMD = [\n",
    "    \"python\", \"-m\", \"clip_train.main\"\n",
    "]\n",
    "\n",
    "\n",
    "def run_config(vw, tw):\n",
    "    name = f\"v{vw}_t{tw}\"\n",
    "    cfg_dir = CONFIG_ROOT / name\n",
    "\n",
    "    vision_head_width = 32 if vw == 32 else 64\n",
    "    text_heads = 1 if tw == 32 else tw // 64\n",
    "\n",
    "    build_model_cfg(\n",
    "        text_width=tw,\n",
    "        vision_width=vw,\n",
    "        out_path=cfg_dir,\n",
    "        vision_head_width=vision_head_width,\n",
    "        text_heads=text_heads,\n",
    "    )\n",
    "\n",
    "    cmd = TRAIN_BASE_CMD + [\n",
    "        \"--warmup-fraction\", \"0.5\",\n",
    "        \"--batch-size\", \"4\",\n",
    "        \"--precision\", \"amp\",\n",
    "        \"--dataset-type\", \"webdataset\",\n",
    "        \"--workers\", \"0\",\n",
    "        \"--val-data\", \"validation_data/{00000000..00000004}.tar\",\n",
    "        \"--epochs\", \"1\",\n",
    "        \"--train-num-samples\", \"32\",\n",
    "        \"--train-data\", \"validation_data/{00000000..00000004}.tar\",\n",
    "        \"--lr-scheduler\", \"const\",\n",
    "        \"--model\", f\"local-dir:{cfg_dir.as_posix()}\",\n",
    "        \"--name\", name\n",
    "    ]\n",
    "\n",
    "    print(\"\\n==============================\")\n",
    "    print(\"Running\", name)\n",
    "    print(\"==============================\")\n",
    "\n",
    "    subprocess.run(cmd, check=True)\n",
    "\n",
    "\n",
    "for vw in WIDTHS:\n",
    "    for tw in WIDTHS:\n",
    "        run_config(vw, tw)\n",
    "\n",
    "ROOT = Path(\"logs\")\n",
    "OUTFILE = \"ckpt_sizes.json\"\n",
    "\n",
    "sizes = {}\n",
    "\n",
    "for model_dir in sorted(ROOT.iterdir()):\n",
    "    if not model_dir.is_dir():\n",
    "        continue\n",
    "\n",
    "    name = model_dir.name\n",
    "    ckpt = model_dir / \"checkpoints\" / \"epoch_1.pt\"\n",
    "\n",
    "    if not ckpt.exists():\n",
    "        print(f\"Missing checkpoint: {name}\")\n",
    "        continue\n",
    "\n",
    "    size_gb = ckpt.stat().st_size / (1024 ** 3)\n",
    "    sizes[name] = round(size_gb, 4)\n",
    "\n",
    "    print(f\"{name}: {size_gb:.4f} GB\")\n",
    "\n",
    "with open(OUTFILE, \"w\") as f:\n",
    "    json.dump(sizes, f, indent=2)\n",
    "\n",
    "print(\"\\nSaved to\", OUTFILE)\n"
