   "source": [
    "# Different possibilities:\n",
    "# 1. Inverse transform sampling(To map uniform random values to any target distribution, you use the inverse CDF of that distribution) of values from uniform distribution to exponential(lambda) distribution. We need to truncate and shift the distribution.\n",
    "# 2. sample directly from a log distribution. Same logic by finding the inverse CDF. Could have another warping param.\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "lower = 0.6\n",
    "upper = 60.0\n",
    "n = 20000\n",
    "\n",
    "# alpha = 1.0 pure log-uniform\n",
    "# alpha > 1.0 increasingly biased towards the lower bound\n",
    "alpha = 1.0\n",
    "\n",
    "rng = np.random.default_rng(42)\n",
    "u = rng.uniform(0.0, 1.0, size=n)\n",
    "\n",
    "samples = lower * (upper / lower) ** (u ** alpha)\n",
    "\n",
    "plt.figure()\n",
    "plt.scatter(np.arange(1, n + 1), samples)\n",
    "plt.xlabel(\"Sample index\")\n",
    "plt.ylabel(\"train_num_samples (millions)\")\n",
    "plt.title(f\"Samples biased toward small values (alpha={alpha})\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()\n",
    "\n",
    "plt.figure()\n",
    "plt.hist(samples, bins=20)\n",
    "plt.xlabel(\"train_num_samples (millions)\")\n",
    "plt.ylabel(\"Count\")\n",
    "plt.title(f\"Histogram of 100 biased samples (alpha={alpha})\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()\n"
   ]
  },
