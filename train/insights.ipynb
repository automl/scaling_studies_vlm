    "def decade_percentages(train_samples: pd.Series, low: float = 0.6e6, high: float = 60e6):\n",
    "    s = pd.to_numeric(train_samples, errors=\"coerce\")\n",
    "    s = s[np.isfinite(s)]\n",
    "    s = s[(s >= low) & (s <= high)]\n",
    "    total = int(s.shape[0])\n",
    "    if total == 0:\n",
    "        return (np.nan, np.nan, 0, 0, 0)\n",
    "\n",
    "    split = low * 10\n",
    "    first = int((s < split).sum())\n",
    "    second = int((s >= split).sum())\n",
    "\n",
    "    first_pct = 100.0 * first / total\n",
    "    second_pct = 100.0 * second / total\n",
    "    return first_pct, second_pct, first, second, total\n",
    "\n",
    "\n",
    "first_pct, second_pct, first_cnt, second_cnt, total_cnt = decade_percentages(df[\"train_num_samples\"])\n",
    "print(f\"Train_num_samples decade split (valid in [0.6M, 60M]): n={total_cnt}\")\n",
    "print(f\"  0.6M–6M:  {first_cnt} configs ({first_pct:.2f}%)\")\n",
    "print(f\"  6M–60M:   {second_cnt} configs ({second_pct:.2f}%)\")"
