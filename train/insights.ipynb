    "    \"beta1\",\n",
    "    \"beta2\",\n",
    "    \"eps\",\n",
    "    \"text_width\",\n",
    "    \"vision_width\",\n",
    "    \"mparams\",\n",
    "    \"total_samples\",\n",
    "    \"Total compute(GLOPs)\",\n",
    "]\n",
    "\n",
    "cols = [c for c in cols if c in df.columns]\n",
