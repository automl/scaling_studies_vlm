  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "import pandas as pd\n",
    "\n",
    "\n",
    "def fill_last_epoch_duration(df):\n",
    "    df = df.sort_values([\"config_id\", \"epoch\"]).copy()\n",
    "\n",
    "    for cid, g in df.groupby(\"config_id\"):\n",
    "        g = g.sort_values(\"epoch\")\n",
    "\n",
    "        if len(g) < 2:\n",
    "            continue\n",
    "\n",
    "        last = g.iloc[-1]\n",
    "        prev = g.iloc[-2]\n",
    "\n",
    "        if pd.notna(last[\"train_duration(s)\"]):\n",
    "            continue\n",
    "\n",
    "        delta_last = last[\"samples_seen_frac\"] - prev[\"samples_seen_frac\"]\n",
    "        delta_prev = prev[\"samples_seen_frac\"] - g.iloc[-3][\"samples_seen_frac\"] if len(g) > 2 else prev[\n",
    "            \"samples_seen_frac\"]\n",
    "\n",
    "        if delta_prev <= 0:\n",
    "            continue\n",
    "\n",
    "        rate = prev[\"train_duration(s)\"] / delta_prev\n",
    "\n",
    "        df.loc[last.name, \"train_duration(s)\"] = delta_last * rate\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "df = pd.read_csv(\"../surrogate_benchmark/vlm/data.csv\")\n",
    "updated_df = fill_last_epoch_duration(df)\n",
    "updated_df.to_csv(\"../surrogate_benchmark/data.csv\", index=False)"
   ],
