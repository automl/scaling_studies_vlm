  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "\n",
    "def load_data(csv_path: str) -> pd.DataFrame:\n",
    "    return pd.read_csv(csv_path)\n",
    "\n",
    "\n",
    "def build_failure_labels(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    fail_df = (\n",
    "        df.groupby(\"config_id\", as_index=False)[\"epoch_diverged\"]\n",
    "        .any()\n",
    "        .rename(columns={\"epoch_diverged\": \"failed\"})\n",
    "    )\n",
    "    fail_df[\"failed\"] = fail_df[\"failed\"].astype(int)\n",
    "    return fail_df\n",
    "\n",
    "\n",
    "def keep_only_nonfailed_last_epoch(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    fail_df = build_failure_labels(df)\n",
    "\n",
    "    df = df.merge(fail_df, on=\"config_id\", how=\"left\")\n",
    "    df_nonfailed = df[df[\"failed\"] == 0].copy()\n",
    "\n",
    "    df_last = (\n",
    "        df_nonfailed\n",
    "        .sort_values([\"config_id\", \"epoch\"])\n",
    "        .drop_duplicates(subset=\"config_id\", keep=\"last\")\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "    return df_last\n",
    "\n",
    "\n",
    "def create_gflops_decades(\n",
    "        df: pd.DataFrame,\n",
    "        gflops_col: str,\n",
    "        num_decades: int = 3,\n",
    ") -> tuple[pd.DataFrame, np.ndarray, list[str]]:\n",
    "    min_gflops = df[gflops_col].min()\n",
    "    max_gflops = df[gflops_col].max()\n",
    "\n",
    "    print(\"Min GFLOPs:\", min_gflops)\n",
    "    print(\"Max GFLOPs:\", max_gflops)\n",
    "\n",
    "    log_min = np.log(min_gflops)\n",
    "    log_max = np.log(max_gflops)\n",
    "\n",
    "    bins = np.linspace(log_min, log_max, num_decades + 1)\n",
    "    labels = [f\"decade_{i + 1}\" for i in range(num_decades)]\n",
    "\n",
    "    df = df.copy()\n",
    "    df[\"gflops_bin\"] = pd.cut(\n",
    "        np.log(df[gflops_col]),\n",
    "        bins=bins,\n",
    "        labels=labels,\n",
    "        include_lowest=True,\n",
    "    )\n",
    "\n",
    "    return df, bins, labels\n",
    "\n",
    "\n",
    "def print_decade_counts(df: pd.DataFrame, col: str = \"gflops_bin\") -> None:\n",
    "    counts = df[col].value_counts().sort_index()\n",
    "    print(\"\\nCounts per decade:\")\n",
    "    print(counts)\n",
    "\n",
    "\n",
    "def plot_gflops_distribution(\n",
    "        df: pd.DataFrame,\n",
    "        gflops_col: str,\n",
    "        bins: np.ndarray,\n",
    "        title: str = \"Config distribution across compute decades\",\n",
    ") -> None:\n",
    "    x = df[gflops_col]\n",
    "\n",
    "    plt.figure(figsize=(8, 2))\n",
    "    plt.scatter(x, [0] * len(x), alpha=0.6)\n",
    "\n",
    "    for b in np.exp(bins):\n",
    "        plt.axvline(b)\n",
    "\n",
    "    plt.xscale(\"log\")\n",
    "    plt.yticks([])\n",
    "    plt.xlabel(\"Total Compute (GFLOPs)\")\n",
    "    plt.title(title)\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def split_each_decade(\n",
    "        df: pd.DataFrame,\n",
    "        labels: list[str],\n",
    "        test_size: float = 0.2,\n",
    "        random_state: int = 42,\n",
    ") -> tuple[pd.DataFrame, pd.DataFrame]:\n",
    "    train_parts = []\n",
    "    test_parts = []\n",
    "\n",
    "    for decade in labels:\n",
    "        decade_df = df[df[\"gflops_bin\"] == decade].copy()\n",
    "\n",
    "        train_decade, test_decade = train_test_split(\n",
    "            decade_df,\n",
    "            test_size=test_size,\n",
    "            random_state=random_state,\n",
    "        )\n",
    "\n",
    "        train_parts.append(train_decade)\n",
    "        test_parts.append(test_decade)\n",
    "\n",
    "    train_df = pd.concat(train_parts).sort_values(\"config_id\").reset_index(drop=True)\n",
    "    test_df = pd.concat(test_parts).sort_values(\"config_id\").reset_index(drop=True)\n",
    "\n",
    "    return train_df, test_df\n",
    "\n",
    "\n",
    "def print_split_summary(train_df: pd.DataFrame, test_df: pd.DataFrame) -> None:\n",
    "    print(\"\\nTrain counts per decade:\")\n",
    "    print(train_df[\"gflops_bin\"].value_counts().sort_index())\n",
    "\n",
    "    print(\"\\nTest counts per decade:\")\n",
    "    print(test_df[\"gflops_bin\"].value_counts().sort_index())\n",
    "\n",
    "    print(\"\\nTotal train:\", len(train_df))\n",
    "    print(\"Total test:\", len(test_df))\n",
    "\n",
    "\n",
    "def enrich_with_all_epochs(\n",
    "        full_df: pd.DataFrame,\n",
    "        selected_configs_df: pd.DataFrame,\n",
    "        keep_only_nonfailed: bool = True,\n",
    ") -> pd.DataFrame:\n",
    "    selected_config_ids = selected_configs_df[\"config_id\"].unique()\n",
    "\n",
    "    enriched_df = full_df[full_df[\"config_id\"].isin(selected_config_ids)].copy()\n",
    "\n",
    "    if keep_only_nonfailed:\n",
    "        fail_df = build_failure_labels(full_df)\n",
    "        enriched_df = enriched_df.merge(fail_df, on=\"config_id\", how=\"left\")\n",
    "        enriched_df = enriched_df[enriched_df[\"failed\"] == 0].copy()\n",
    "\n",
    "    enriched_df = enriched_df.sort_values([\"config_id\", \"epoch\"]).reset_index(drop=True)\n",
    "    return enriched_df\n",
    "\n",
    "\n",
    "def main():\n",
