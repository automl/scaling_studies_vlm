    "\n",
    "base_out = Path(\"model_cfg\")\n",
    "\n",
    "for text_w, vision_w in product(vision_widths, text_widths):\n",
    "    head_w = 32 if vision_w == 32 else 64\n",
    "    text_heads = max(1, text_w // 64)\n",
    "    out_path = base_out / f\"text_{text_w}_vision_{vision_w}\"\n",
    "    out_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    build_model_cfg(\n",
    "        text_width=text_w,\n",
    "        vision_width=vision_w,\n",
    "        vision_head_width=head_w,\n",
    "        text_heads=text_heads,\n",
    "        out_path=out_path,\n",
    "    )"
