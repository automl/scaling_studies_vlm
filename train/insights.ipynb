    "plt.figure()\n",
    "plt.xscale(\"log\")\n",
    "plt.scatter(np.log10(C), np.zeros_like(C), label=\"Actual models\")\n",
    "plt.scatter(target_logs, np.zeros_like(target_logs), marker=\"x\", label=\"Target log points\")\n",
    "\n",
    "plt.yticks([])\n",
    "plt.xlabel(\"log10(GFLOPs)\")\n",
    "plt.legend()\n",
    "plt.title(\"Actual compute vs. 5 target log-spaced baseline points\")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "C = np.array([7.05e+6, 1.5e+7, 1.69e+7, 3.5e+7, 7.05e+7, 1.24e+8, 1.69e+8, 3.52e+8,\n",
    "              6.23e+8])  # considering first 9 models, assuming we have 64m samples\n",
    "Cmin, Cmax = C.min(), C.max()\n",
    "\n",
    "target_logs = np.linspace(np.log10(Cmin), np.log10(Cmax), 5)\n",
    "plt.figure()\n",
    "plt.xscale(\"log\")\n",
    "plt.scatter(np.log10(C), np.zeros_like(C), label=\"Actual models\")\n",
